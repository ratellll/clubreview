 <div class="form-container mb-5">
        <h3>👤 내 정보</h3>
        <div class="mb-3">
            <label>아이디</label>
            <input type="text" class="form-control" th:value="${user.username}" readonly>
        </div>
        <div class="mb-3">
            <label>닉네임</label>
            <input type="text" class="form-control" th:value="${user.nickname}" readonly>
        </div>
        <div class="mb-3">
            <label>전화번호</label>
            <input type="text" class="form-control" th:value="${user.phoneNumber}" readonly>
        </div>
    </div>


    <div class="form-container mb-5">
        <h3>✏️ 닉네임 수정</h3>
        <form th:action="@{/mypage/editNickname}" method="post">
            <div class="mb-3">
                <label for="nickname" class="form-label">새로운 닉네임</label>
                <input type="text" class="form-control" id="nickname" name="nickname" placeholder="새 닉네임을 입력하세요" required>
                <button type="button" id="checkNicknameBtn" class="btn btn-secondary mt-2">중복 체크</button>
                <div id="nicknameCheckResult" class="mt-2"></div>
            </div>
            <button type="submit" class="btn btn-primary w-100">닉네임 수정</button>
        </form>
    </div>

    <!-- Password Update Form -->
    <div class="form-container mb-5">
        <h3>🔐 비밀번호 변경</h3>
        <form th:action="@{/mypage/editPassword}" method="post">
            <div class="mb-3">
                <label for="password" class="form-label">새 비밀번호</label>
                <input type="password" class="form-control" id="password" name="password" placeholder="새 비밀번호를 입력하세요" required>
            </div>
            <button type="submit" class="btn btn-primary w-100">비밀번호 변경</button>
        </form>
    </div>

    <!-- Review List Section -->
    <div class="review-list">
        <h3>📝 내가 쓴 리뷰</h3>

        <div th:if="${#lists.isEmpty(reviews)}">
            <p>작성한 리뷰가 없습니다.</p>
        </div>

        <div th:each="review : ${reviews}" class="mb-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title" th:text="'클럽: ' + ${review.clubName}"></h5>
                    <p class="card-text" th:text="'리뷰: ' + ${review.comment}"></p>
                    <p class="card-text"><small class="text-muted" th:text="'평점: ' + ${review.rating} + ' ⭐'"></small></p>
                </div>
            </div>
        </div>
    </div>
</div>